# QYX MedTech CASA backend — environment variables
# Copy this file to .env to override any default in app/config.py.

APP_NAME=QYX MedTech CASA
DEBUG=false
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY

# CORS — only needed when the Vite dev server (npm run dev) runs separately
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# CASA pipeline (defaults point at this repository's training/ folder)
# TRAINING_DIR=C:/path/to/QYX_MedTech/training
# PIPELINE_CONFIG=C:/path/to/QYX_MedTech/training/configs/default.yaml
# DATA_DIR=C:/path/to/QYX_MedTech/backend/data
MAX_UPLOAD_MB=500

LOG_LEVEL=INFO
